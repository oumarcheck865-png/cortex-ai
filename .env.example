# ===========================================================================
# Cortex AI — environment configuration
# ===========================================================================
# Copy this file to `.env` (and `.env.local` for the landing app) and fill in
# the values for YOUR infrastructure. Cortex AI has NO mandatory cloud
# dependency and NO embedded API keys — every secret is provided by you.
# ===========================================================================

# ---------------------------------------------------------------------------
# LLM / Model configuration (bring your own model)
# ---------------------------------------------------------------------------
# Cortex AI is model-agnostic. Point it at any OpenAI-compatible endpoint,
# your own provider, or a local model server (vLLM, Ollama, llama.cpp, ...).
CORTEX_LLM_BASE_URL=http://localhost:11434/v1
CORTEX_LLM_API_KEY=            # your key; leave empty for local/no-auth endpoints
CORTEX_LLM_MODEL=cortex-default
# Optional: a separate, stronger model for planning/reasoning
CORTEX_LLM_LARGE_MODEL=

# ---------------------------------------------------------------------------
# Agent server (your own server / GPU resources)
# ---------------------------------------------------------------------------
# Where the OpenHands-derived agent server runs. Local by default.
CORTEX_AGENT_SERVER_URL=http://localhost:8000
CORTEX_AGENT_SERVER_API_KEY=   # set if your agent server requires auth

# ---------------------------------------------------------------------------
# Auth backend (replace the placeholder client-side auth with a real backend)
# ---------------------------------------------------------------------------
# The landing app ships a client-side AuthProvider ready to call a backend.
# Set these to wire it to your auth service (e.g. your own /api/auth/*).
CORTEX_AUTH_API_BASE_URL=http://localhost:3000/api/auth
CORTEX_AUTH_JWT_SECRET=        # generate a strong secret for signing sessions

# ---------------------------------------------------------------------------
# Optional integrations (all OFF by default — no telemetry, no third-parties)
# ---------------------------------------------------------------------------
CORTEX_ENABLE_TELEMETRY=false
CORTEX_GITHUB_TOKEN=           # only if you use GitHub automations
CORTEX_SLACK_BOT_TOKEN=        # only if you use Slack automations

# ---------------------------------------------------------------------------
# Landing app (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CORTEX_APP_URL=http://localhost:3000/app
